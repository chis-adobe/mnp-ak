{
  "$comment": "Authoring block library for the MNP DA project. Mirrors component-definition.json (groups > components > plugins.da scaffolds) and enriches each block with its field model, description, and container nesting rules. Use as the source of truth for which blocks authors can insert and what structure each one expects. Dynamic blocks (rows/columns = 0) generate their own content at runtime and need no authored input.",
  "groups": [
    {
      "title": "Content Blocks",
      "id": "content",
      "components": [
        {
          "title": "Hero",
          "id": "hero",
          "description": "Full-width hero with a background/feature image and rich text.",
          "model": "hero",
          "fields": [
            { "component": "reference", "valueType": "string", "name": "image", "label": "Image", "multi": false },
            { "component": "richtext", "valueType": "string", "name": "text", "label": "Text" }
          ],
          "plugins": {
            "da": {
              "name": "hero",
              "rows": 1,
              "columns": 2,
              "fields": [
                { "name": "image", "selector": "div:nth-child(1) img[src]" },
                { "name": "text", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Mini Hero",
          "id": "mini-hero",
          "description": "Dynamic. Generates the page title from city metadata. No authored content needed.",
          "dynamic": true,
          "model": "mini-hero",
          "fields": [
            { "component": "text", "valueType": "string", "name": "info", "label": "Dynamic Block", "value": "Generates title from page city metadata. No editing required." }
          ],
          "plugins": {
            "da": { "name": "mini-hero", "rows": 0, "columns": 0 }
          }
        },
        {
          "title": "Breadcrumb",
          "id": "breadcrumb",
          "description": "Dynamic. Generates breadcrumb navigation from the page hierarchy. No authored content needed.",
          "dynamic": true,
          "model": "breadcrumb",
          "fields": [
            { "component": "text", "valueType": "string", "name": "info", "label": "Dynamic Block", "value": "Generates breadcrumb from page hierarchy. No editing required." }
          ],
          "plugins": {
            "da": { "name": "breadcrumb", "rows": 0, "columns": 0 }
          }
        },
        {
          "title": "Accordion",
          "id": "accordion",
          "description": "Container for collapsible accordion items.",
          "model": "accordion",
          "fields": [],
          "container": ["accordion-item"],
          "filter": "accordion",
          "plugins": {
            "da": { "name": "accordion", "rows": 1, "columns": 2 }
          }
        },
        {
          "title": "Accordion Item",
          "id": "accordion-item",
          "description": "A single accordion row: a summary (clickable header) and expandable body text.",
          "model": "accordion-item",
          "fields": [
            { "component": "richtext", "valueType": "string", "name": "summary", "label": "Summary" },
            { "component": "richtext", "valueType": "string", "name": "text", "label": "Text" }
          ],
          "plugins": {
            "da": {
              "name": "accordion-item",
              "rows": 2,
              "columns": 0,
              "fields": [
                { "name": "summary", "selector": "div:nth-child(1)" },
                { "name": "text", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Columns",
          "id": "columns",
          "description": "Two side-by-side rich text columns.",
          "model": "columns",
          "fields": [
            { "component": "richtext", "valueType": "string", "name": "col1", "label": "Column 1" },
            { "component": "richtext", "valueType": "string", "name": "col2", "label": "Column 2" }
          ],
          "plugins": {
            "da": {
              "name": "columns",
              "rows": 1,
              "columns": 2,
              "fields": [
                { "name": "col1", "selector": "div:nth-child(1)" },
                { "name": "col2", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Table",
          "id": "table",
          "description": "Rich text rendered as a table.",
          "model": "table",
          "fields": [
            { "component": "richtext", "valueType": "string", "name": "content", "label": "Content" }
          ],
          "plugins": {
            "da": {
              "name": "table",
              "rows": 1,
              "columns": 1,
              "fields": [
                { "name": "content", "selector": "div:nth-child(1)" }
              ]
            }
          }
        },
        {
          "title": "Card",
          "id": "card",
          "description": "A single card with an image and rich text.",
          "model": "card",
          "fields": [
            { "component": "reference", "valueType": "string", "name": "image", "label": "Image", "multi": false },
            { "component": "richtext", "valueType": "string", "name": "text", "label": "Text" }
          ],
          "plugins": {
            "da": {
              "name": "card",
              "rows": 1,
              "columns": 2,
              "fields": [
                { "name": "image", "selector": "div:nth-child(1) img[src]" },
                { "name": "text", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Carousel",
          "id": "carousel",
          "description": "Container for carousel slides.",
          "model": "carousel",
          "fields": [],
          "container": ["carousel-slide"],
          "filter": "carousel",
          "plugins": {
            "da": { "name": "carousel", "rows": 1, "columns": 2 }
          }
        },
        {
          "title": "Carousel Slide",
          "id": "carousel-slide",
          "description": "A single carousel slide with an image and rich text.",
          "model": "carousel-slide",
          "fields": [
            { "component": "reference", "valueType": "string", "name": "image", "label": "Image", "multi": false },
            { "component": "richtext", "valueType": "string", "name": "text", "label": "Text" }
          ],
          "plugins": {
            "da": {
              "name": "carousel-slide",
              "rows": 1,
              "columns": 2,
              "fields": [
                { "name": "image", "selector": "div:nth-child(1) img[src]" },
                { "name": "text", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Rich Text",
          "id": "richtext",
          "description": "Free-form rich text region. No decoration applied.",
          "model": "richtext",
          "fields": [
            { "component": "richtext", "valueType": "string", "name": "content", "label": "Content" }
          ],
          "plugins": {
            "da": {
              "name": "richtext",
              "rows": 1,
              "columns": 1,
              "fields": [
                { "name": "content", "selector": "div:nth-child(1)" }
              ]
            }
          }
        },
        {
          "title": "YouTube",
          "id": "youtube",
          "description": "Embeds a YouTube video (privacy-enhanced, no-cookie). Author a YouTube link or video ID.",
          "model": "youtube",
          "fields": [
            { "component": "aem-content", "valueType": "string", "name": "link", "label": "YouTube URL or Video ID" }
          ],
          "plugins": {
            "da": {
              "name": "youtube",
              "rows": 1,
              "columns": 1,
              "fields": [
                { "name": "link", "selector": "div:nth-child(1)" }
              ]
            }
          }
        },
        {
          "title": "Fragment",
          "id": "fragment",
          "description": "Embeds another document (content fragment) by path.",
          "model": "fragment",
          "fields": [
            { "component": "aem-content", "valueType": "string", "name": "reference", "label": "Fragment Path" }
          ],
          "plugins": {
            "da": {
              "name": "fragment",
              "rows": 1,
              "columns": 1,
              "fields": [
                { "name": "reference", "selector": "div:nth-child(1)" }
              ]
            }
          }
        },
        {
          "title": "Advanced Tabs",
          "id": "advanced-tabs",
          "description": "Turns the sections that follow it into tab panels. Author an unordered list where each list item is a tab label; each subsequent section becomes a panel.",
          "model": "advanced-tabs",
          "fields": [
            { "component": "richtext", "valueType": "string", "name": "tabs", "label": "Tab Labels (unordered list)" }
          ],
          "plugins": {
            "da": {
              "name": "advanced-tabs",
              "rows": 1,
              "columns": 1,
              "fields": [
                { "name": "tabs", "selector": "div:nth-child(1)" }
              ]
            }
          }
        }
      ]
    },
    {
      "title": "Article & Insights Blocks",
      "id": "article",
      "components": [
        {
          "title": "Article",
          "id": "article",
          "description": "Article body layout. Author key/value rows: 'authors' (one or more /personnel/* paths, comma- or line-separated) and 'copy' (the article rich text). Renders title bar, synopsis, author cards, copy, related content, and insights.",
          "model": "article",
          "fields": [
            { "component": "text", "valueType": "string", "name": "key", "label": "Field (authors | copy)" },
            { "component": "richtext", "valueType": "string", "name": "value", "label": "Value" }
          ],
          "plugins": {
            "da": {
              "name": "article",
              "rows": 2,
              "columns": 2,
              "fields": [
                { "name": "key", "selector": "div:nth-child(1)" },
                { "name": "value", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Article Hero",
          "id": "article-hero",
          "description": "Dynamic. Builds the article header (title, publication date, hero image) from page metadata. Author image URLs are transformed to the publish tier automatically. No authored content needed.",
          "dynamic": true,
          "model": "article-hero",
          "fields": [
            { "component": "text", "valueType": "string", "name": "info", "label": "Dynamic Block", "value": "Generates article hero from page metadata. No editing required." }
          ],
          "plugins": {
            "da": { "name": "article-hero", "rows": 0, "columns": 0 }
          }
        },
        {
          "title": "Article Tags",
          "id": "article-tags",
          "description": "Dynamic. Renders taxonomy tag links from the page 'insights' metadata. No authored content needed.",
          "dynamic": true,
          "model": "article-tags",
          "fields": [
            { "component": "text", "valueType": "string", "name": "info", "label": "Dynamic Block", "value": "Generates tags from page insights metadata. No editing required." }
          ],
          "plugins": {
            "da": { "name": "article-tags", "rows": 0, "columns": 0 }
          }
        },
        {
          "title": "Author Data",
          "id": "author-data",
          "description": "Personnel profile (full layout). Author key/value rows. Keys: name, certifications, role, phone, toll-free, email, fax, address, thumbnail (image), profile (multi-paragraph bio).",
          "model": "author-data",
          "fields": [
            { "component": "text", "valueType": "string", "name": "key", "label": "Field" },
            { "component": "richtext", "valueType": "string", "name": "value", "label": "Value" }
          ],
          "plugins": {
            "da": {
              "name": "author-data",
              "rows": 10,
              "columns": 2,
              "fields": [
                { "name": "key", "selector": "div:nth-child(1)" },
                { "name": "value", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Author Info",
          "id": "author-info",
          "description": "Compact personnel info block. Author key/value rows (name, role, phone, email, etc.). Used inside fragments referenced by other blocks.",
          "model": "author-info",
          "fields": [
            { "component": "text", "valueType": "string", "name": "key", "label": "Field" },
            { "component": "richtext", "valueType": "string", "name": "value", "label": "Value" }
          ],
          "plugins": {
            "da": {
              "name": "author-info",
              "rows": 6,
              "columns": 2,
              "fields": [
                { "name": "key", "selector": "div:nth-child(1)" },
                { "name": "value", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Search Results",
          "id": "search-results",
          "description": "Dynamic. Renders searchable, filterable results from the article and content query indexes. No authored content needed.",
          "dynamic": true,
          "model": "search-results",
          "fields": [
            { "component": "text", "valueType": "string", "name": "info", "label": "Dynamic Block", "value": "Generates search results from query indexes. No editing required." }
          ],
          "plugins": {
            "da": { "name": "search-results", "rows": 0, "columns": 0 }
          }
        }
      ]
    },
