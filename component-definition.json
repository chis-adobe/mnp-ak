{
  "groups": [
    {
      "title": "Content Blocks",
      "id": "content",
      "components": [
        {
          "title": "Hero",
          "id": "hero",
          "model": "hero",
          "plugins": {
            "da": {
              "name": "hero",
              "rows": 1,
              "columns": 2,
              "fields": [
                { "name": "image", "selector": "div:nth-child(1) img[src]" },
                { "name": "text", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Mini Hero",
          "id": "mini-hero",
          "description": "Dynamically generates title from page city metadata. No authored content needed.",
          "model": "mini-hero",
          "plugins": {
            "da": {
              "name": "mini-hero",
              "rows": 0,
              "columns": 0
            }
          }
        },
        {
          "title": "Breadcrumb",
          "id": "breadcrumb",
          "description": "Dynamically generates breadcrumb navigation from page hierarchy. No authored content needed.",
          "model": "breadcrumb",
          "plugins": {
            "da": {
              "name": "breadcrumb",
              "rows": 0,
              "columns": 0
            }
          }
        },
        {
          "title": "Accordion",
          "id": "accordion",
          "model": "accordion",
          "filter": "accordion",
          "plugins": {
            "da": {
              "name": "accordion",
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Accordion Item",
          "id": "accordion-item",
          "model": "accordion-item",
          "plugins": {
            "da": {
              "name": "accordion-item",
              "rows": 2,
              "columns": 0,
              "fields": [
                { "name": "summary", "selector": "div:nth-child(1)" },
                { "name": "text", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Columns",
          "id": "columns",
          "model": "columns",
          "plugins": {
            "da": {
              "name": "columns",
              "rows": 1,
              "columns": 2,
              "fields": [
                { "name": "col1", "selector": "div:nth-child(1)" },
                { "name": "col2", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Table",
          "id": "table",
          "model": "table",
          "plugins": {
            "da": {
              "name": "table",
              "rows": 1,
              "columns": 1,
              "fields": [
                { "name": "content", "selector": "div:nth-child(1)" }
              ]
            }
          }
        },
        {
          "title": "Card",
          "id": "card",
          "model": "card",
          "plugins": {
            "da": {
              "name": "card",
              "rows": 1,
              "columns": 2,
              "fields": [
                { "name": "image", "selector": "div:nth-child(1) img[src]" },
                { "name": "text", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Carousel",
          "id": "carousel",
          "model": "carousel",
          "filter": "carousel",
          "plugins": {
            "da": {
              "name": "carousel",
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Carousel Slide",
          "id": "carousel-slide",
          "model": "carousel-slide",
          "plugins": {
            "da": {
              "name": "carousel-slide",
              "rows": 1,
              "columns": 2,
              "fields": [
                { "name": "image", "selector": "div:nth-child(1) img[src]" },
                { "name": "text", "selector": "div:nth-child(2)" }
              ]
            }
          }
        }
      ]
    },
    {
      "title": "Office Blocks",
      "id": "office",
      "components": [
        {
          "title": "Office Info",
          "id": "office-info",
          "model": "office-info",
          "plugins": {
            "da": {
              "name": "office-info",
              "rows": 1,
              "columns": 1,
              "fields": [
                { "name": "content", "selector": "div:nth-child(1)" }
              ]
            }
          }
        },
        {
          "title": "Services Links",
          "id": "services-links",
          "model": "services-links",
          "filter": "services-links",
          "plugins": {
            "da": {
              "name": "services-links",
              "rows": 1,
              "columns": 1
            }
          }
        },
        {
          "title": "Service Link Item",
          "id": "services-links-item",
          "model": "services-links-item",
          "plugins": {
            "da": {
              "name": "services-links-item",
              "rows": 1,
              "columns": 0,
              "fields": [
                { "name": "link", "selector": "div:nth-child(1)" }
              ]
            }
          }
        },
        {
          "title": "Contact Card",
          "id": "contact-card",
          "model": "contact-card",
          "plugins": {
            "da": {
              "name": "contact-card",
              "rows": 1,
              "columns": 3,
              "fields": [
                { "name": "image", "selector": "div:nth-child(1) img[src]" },
                { "name": "info", "selector": "div:nth-child(2)" },
                { "name": "bio", "selector": "div:nth-child(3)" }
              ]
            }
          }
        },
        {
          "title": "Contact Form",
          "id": "contact-form",
          "model": "contact-form",
          "plugins": {
            "da": {
              "name": "contact-form",
              "rows": 1,
              "columns": 2,
              "fields": [
                { "name": "label", "selector": "div:nth-child(1)" },
                { "name": "type", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Insights Cards",
          "id": "insights-cards",
          "model": "insights-cards",
          "filter": "insights-cards",
          "plugins": {
            "da": {
              "name": "insights-cards",
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Insights Card Item",
          "id": "insights-cards-item",
          "model": "insights-cards-item",
          "plugins": {
            "da": {
              "name": "insights-cards-item",
              "rows": 1,
              "columns": 2,
              "fields": [
                { "name": "image", "selector": "div:nth-child(1) img[src]" },
                { "name": "text", "selector": "div:nth-child(2)" }
              ]
            }
          }
        },
        {
          "title": "Offices List",
          "id": "offices-list",
          "description": "Dynamically lists all offices from the query index. No authored content needed.",
          "model": "offices-list",
          "plugins": {
            "da": {
              "name": "offices-list",
              "rows": 0,
              "columns": 0
            }
          }
        }
      ]
    },
    {
      "title": "Marketing Blocks",
      "id": "marketing",
      "components": [
        {
          "title": "CTA Banner",
          "id": "cta-banner",
          "model": "cta-banner",
          "plugins": {
            "da": {
              "name": "cta-banner",
              "rows": 1,
              "columns": 1,
              "fields": [
                { "name": "content", "selector": "div:nth-child(1)" }
              ]
            }
          }
        },
        {
          "title": "Feature Banner",
          "id": "feature-banner",
          "description": "Stacked image-and-text rows with no spacing. Each row: image, text, and a colour name (grey, white, teal-light, teal, dark-teal) that sets the row background.",
          "model": "feature-banner",
          "plugins": {
            "da": {
              "name": "feature-banner",
              "rows": 1,
              "columns": 3,
              "fields": [
                { "name": "image", "selector": "div:nth-child(1) img[src]" },
                { "name": "text", "selector": "div:nth-child(2)" },
                { "name": "color", "selector": "div:nth-child(3)" }
              ]
            }
          }
        }
      ]
    }
  ]
}
